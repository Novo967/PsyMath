rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated editors and admins can upload files.
    // All authenticated users can read files (for displaying images in questions).

    // Question images
    match /questions/{instituteId}/{allPaths=**} {
      // Any authenticated user can read (needed to display question images)
      allow read: if request.auth != null;
      // Only editors/admins can write
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Study material images (future use)
    match /materials/{instituteId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
