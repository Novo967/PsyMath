rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      let data = getUserData();
      // שימוש ב-get כדי למנוע שגיאה עבור משתמשי האפליקציה הישנה שאין להם את השדה הזה
      return data.get('role', 'student'); 
    }

    function getUserInstituteId() {
      let data = getUserData();
      // מחזיר null אם השדה לא קיים
      return data.get('instituteId', null);
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isEditorOrAdmin() {
      return isSignedIn() && (getUserRole() == 'editor' || getUserRole() == 'admin');
    }

    function belongsToSameInstitute(resourceInstituteId) {
      let userInst = getUserInstituteId();
      return userInst != null && userInst == resourceInstituteId;
    }

    // ─── App Config (Version Control) ───
    match /appConfig/{document} {
      // חייב להישאר פתוח לכולם כדי שהאפליקציה באוויר תוכל לבדוק גרסה במסך הטעינה
      allow read: if true;
      allow write: if false; 
    }

    // ─── Users Collection ───
    match /users/{userId} {
      // משתמשים רגילים יכולים לקרוא, ליצור ולעדכן את הפרופיל של עצמם
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      // מוודא שהמשתמש לא יכול להעניק לעצמו הרשאות מנהל או לשנות מוסד דרך הקליינט
      allow update: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'instituteId']);
      
      // פעולות ניהול למנהלי מוסד
      allow update: if isAdmin() && belongsToSameInstitute(resource.data.instituteId);
      allow list: if isAdmin() && resource.data.instituteId == getUserInstituteId();

      // תת-קולקציית סימולציות (רלוונטי לשתי הגרסאות)
      match /simulations/{simId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /topicStats/{topicId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
		 
    // ─── Old App Collections (B2C) ───
    
    // האוסף הישן של השאלות - פתוח לקריאה לכל המחוברים באפליקציה הנוכחית
    match /Questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── New B2B App Collections ───
    
    // האוסף החדש של השאלות - תלוי הרשאות ומוסד
    match /questions/{questionId} {
      allow read: if isSignedIn() && belongsToSameInstitute(resource.data.instituteId);
      allow create: if isEditorOrAdmin() && request.resource.data.instituteId == getUserInstituteId();
      allow update, delete: if isEditorOrAdmin() && belongsToSameInstitute(resource.data.instituteId);
    }

    match /question_groups/{groupId} {
      allow read: if isSignedIn() && belongsToSameInstitute(resource.data.instituteId);
      allow create: if isEditorOrAdmin() && request.resource.data.instituteId == getUserInstituteId();
      allow update, delete: if isEditorOrAdmin() && belongsToSameInstitute(resource.data.instituteId);
    }

    match /institutes/{instituteId} {
      allow read: if isSignedIn() && getUserInstituteId() == instituteId;
      allow update: if isAdmin() && getUserInstituteId() == instituteId;
    }

    // ─── Shared Collections ───
    
    // קולקציית חומרי הלימוד - משמשת גם את האפליקציה שבאוויר וגם את ה-B2B
    match /study_chapters/{chapterId} {
      // תנאי חכם: מאפשר קריאה אם זה חומר ישן (ללא instituteId) או חומר השייך למוסד של המשתמש
      allow read: if isSignedIn() && (
        !("instituteId" in resource.data) || 
        belongsToSameInstitute(resource.data.instituteId)
      );
      // כתיבה, עריכה ומחיקה - רק לצוות המוסד
      allow create: if isEditorOrAdmin() && request.resource.data.instituteId == getUserInstituteId();
      allow update, delete: if isEditorOrAdmin() && belongsToSameInstitute(resource.data.instituteId);
    }
  }
}